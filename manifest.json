{
  "manifest_version": 3,
  "name": "Kodik AdBlock",
  "version": "0.1",
  "description": "Блокирует VAST/VPAID рекламу в плеере Kodik",
  "permissions": ["declarativeNetRequest"],
  "host_permissions": [
    "*://*.kodik.info/*",
    "*://*.kodik.biz/*",
    "*://*.kodik.cc/*",
    "*://*.kodik.online/*",
    "*://*.kodikplayer.com/*",
    "*://*.kodik-add.com/*",
    "*://*.kodikres.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.kodik.info/*",
        "*://*.kodik.biz/*",
        "*://*.kodik.cc/*",
        "*://*.kodik.online/*",
        "*://*.kodikplayer.com/*",
        "*://*.kodik-add.com/*",
        "*://*.kodikres.com/*"
      ],
      "js": ["inject.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.kodik.info/*",
        "*://*.kodik.biz/*",
        "*://*.kodik.cc/*",
        "*://*.kodik.online/*",
        "*://*.kodikplayer.com/*",
        "*://*.kodik-add.com/*",
        "*://*.kodikres.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "kodik_ads",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Kodik AdBlock",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  }
}
